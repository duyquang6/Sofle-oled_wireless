 *
 * Layout for niri + Zed (helix mode) + VNI typing, kept close to the MacBook
 * keyboard: Super sits right next to Space under the left thumb.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NAV 1
#define SYM 2
#define ADJUST 3

/ {
    behaviors {
        // Right encoder as a mouse wheel: each detent scrolls a short burst.
        scroll_enc: scroll_enc {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <30>;
        };

        // Caps position: tap = Esc (helix normal mode), hold = Ctrl.
        // hold-preferred: any key pressed while held makes it Ctrl at once, so
        // fast rolled Ctrl+C / Ctrl+V work even if Caps is released first.
        ctl_esc: ctl_esc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        // Right inner thumb: tap = Enter, hold = SYM layer.
        ent_sym: ent_sym {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };
    };

    // Hold NAV + SYM together for ADJUST.
    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <NAV SYM>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";

            // |    `     |  1  |  2  |  3  |  4  |  5  |                 |  6  |  7  |  8  |  9  |  0  |   -   |
            // |   TAB    |  Q  |  W  |  E  |  R  |  T  |                 |  Y  |  U  |  I  |  O  |  P  |   =   |
            // | CTRL/ESC |  A  |  S  |  D  |  F  |  G  |                 |  H  |  J  |  K  |  L  |  ;  |   '   |
            // |  SHIFT   |  Z  |  X  |  C  |  V  |  B  | MUTE |  | OVRV |  N  |  M  |  ,  |  .  |  /  | SHIFT |
            //                  | CTRL| ALT | NAV |SUPER|SPACE |  |ENT/SYM| BSPC| DEL |VI/EN| PSCR|
            // OVRV = Super+O (niri overview). VI/EN = Ctrl+Space (fcitx5 toggle).

            bindings = <
&kp GRAVE           &kp N1     &kp N2    &kp N3    &kp N4    &kp N5                                      &kp N6     &kp N7     &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB             &kp Q      &kp W     &kp E     &kp R     &kp T                                       &kp Y      &kp U      &kp I      &kp O     &kp P     &kp EQUAL
&ctl_esc LCTRL ESC  &kp A      &kp S     &kp D     &kp F     &kp G                                       &kp H      &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT           &kp Z      &kp X     &kp C     &kp V     &kp B     &kp C_MUTE    &kp LG(O)           &kp N      &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                               &kp LCTRL &kp LALT  &mo NAV   &kp LGUI  &kp SPACE     &ent_sym SYM ENTER  &kp BSPC   &kp DEL    &kp LC(SPACE)  &kp PSCRN
            >;

            // Left: volume. Right: mouse wheel (Super+wheel = niri workspace).
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };

        nav_layer {
            display-name = "Nav";

            // |  F1  |  F2  |  F3  |  F4  |  F5  |  F6  |               |  F7  |  F8  |  F9  |  F10 |  F11 |  F12 |
            // |      |      |      |      |      |      |               | HOME | PGDN | PGUP | END  |      |      |
            // |      | SUPER| ALT  | CTRL | SHIFT|      |               |  <-  |  v   |  ^   |  ->  |      |      |
            // |      | UNDO | CUT  | COPY | PASTE| CAPS |      |  |     | PREV | PLAY | NEXT |      |      |      |

            bindings = <
&kp F1    &kp F2     &kp F3     &kp F4     &kp F5     &kp F6                         &kp F7      &kp F8     &kp F9      &kp F10    &kp F11  &kp F12
&trans    &trans     &trans     &trans     &trans     &trans                         &kp HOME    &kp PG_DN  &kp PG_UP   &kp END    &trans   &trans
&trans    &kp LGUI   &kp LALT   &kp LCTRL  &kp LSHFT  &trans                         &kp LEFT    &kp DOWN   &kp UP      &kp RIGHT  &trans   &trans
&trans    &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp CAPS   &trans    &trans    &kp C_PREV  &kp C_PP   &kp C_NEXT  &trans     &trans   &trans
                     &trans     &trans     &trans     &trans     &trans    &trans    &trans      &trans     &trans      &trans
            >;

            // Left: screen brightness. Right: niri focus column left/right.
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &inc_dec_kp LG(RIGHT) LG(LEFT)>;
        };

        sym_layer {
            display-name = "Sym";

            // |      |      |      |      |      |      |               |      |      |      |      |      |      |
            // |  ~   |  !   |  @   |  #   |  $   |  %   |               |  ^   |  &   |  *   |  \   |  |   |      |
            // |      |  `   |  [   |  {   |  (   |  <   |               |  >   |  )   |  }   |  ]   |  :   |  "   |
            // |      |  \   |  |   |  _   |  +   |  =   |      |  |     |      |      |      |      |      |      |

            bindings = <
&trans     &trans     &trans     &trans     &trans     &trans                        &trans     &trans     &trans     &trans     &trans     &trans
&kp TILDE  &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT                     &kp CARET  &kp AMPS   &kp STAR   &kp BSLH   &kp PIPE   &trans
&trans     &kp GRAVE  &kp LBKT   &kp LBRC   &kp LPAR   &kp LT                        &kp GT     &kp RPAR   &kp RBRC   &kp RBKT   &kp COLON  &kp DQT
&trans     &kp BSLH   &kp PIPE   &kp UNDER  &kp PLUS   &kp EQUAL  &trans    &trans   &trans     &trans     &trans     &trans     &trans     &trans
                      &trans     &trans     &trans     &trans     &trans    &trans   &trans     &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };

        adjust_layer {
            display-name = "Adjust";

            // | BTCLR | BT0  | BT1  | BT2  | BT3  | BT4  |                 |USB/BLE|      |      |      |      |       |
            // | EXTPW | HUD  | HUI  | SAD  | SAI  | EFF  |                 |       |      |      |      |      |       |
            // |       | BRD  | BRI  |      |      |      |                 |       |      |      |      |      |       |
            // | BOOT  |      |      |      |      |      | RGBTOG |  |     |       |      |      |      |      | BOOT  |
            // BOOT = enter the UF2 bootloader of that half (no reset button needed).

            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                          &out OUT_TOG  &none   &none   &none   &none   &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                       &none         &none   &none   &none   &none   &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                                 &none         &none   &none   &none   &none   &none
&bootloader        &none            &none            &none            &none            &none            &rgb_ug RGB_TOG  &none   &none         &none   &none   &none   &none   &bootloader
                                    &trans           &trans           &trans           &trans           &trans           &trans  &trans        &trans  &trans  &trans
            >;
        };
    };
};
